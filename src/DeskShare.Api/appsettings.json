{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DeskShare": "Data Source=deskshare.db"
  },
  "Authentication": {
    "Mode": "Oidc",
    "OfficeManagerGroups": [ "DeskShare-OfficeManagers" ],
    "Oidc": {
      "Authority": "",
      "ClientId": "",
      "ClientSecret": "",
      "Scopes": [ "openid", "profile", "email" ],
      "ClaimTypes": {
        "Subject": "sub",
        "Email": "email",
        "Name": "name",
        "Groups": "groups"
      }
    }
  }
}
