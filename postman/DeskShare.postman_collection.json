{
  "info": {
    "name": "DeskShare API",
    "description": "1. Start the API: `dotnet run --project src/DeskShare.Api --launch-profile http`\n2. Send \"Sign in\" first. Postman keeps the auth cookie for the other requests.\n3. Send the requests from top to bottom, or run the whole collection.\n\nTo try as an employee, change `isOfficeManager` to `false` in \"Sign in\".",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5266" },
    { "key": "deskId", "value": "" },
    { "key": "bookingId", "value": "" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// {{date}} is always one week from today.",
          "pm.collectionVariables.set('date', new Date(Date.now() + 7 * 864e5).toISOString().slice(0, 10));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Sign in",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/dev-login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"displayName\": \"Omar Manager\",\n  \"email\": \"omar@contoso.com\",\n  \"isOfficeManager\": true\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Session",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/auth/session" }
        }
      ]
    },
    {
      "name": "2. Desks",
      "item": [
        {
          "name": "Create desk",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.collectionVariables.set('deskId', pm.response.json().id);"] }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/desks",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"D-101\",\n  \"floor\": 1,\n  \"features\": [\"Monitor\", \"Window\"]\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Get all desks",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/desks" }
        },
        {
          "name": "Get desk",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/desks/{{deskId}}" }
        },
        {
          "name": "Update desk",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/desks/{{deskId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"D-101\",\n  \"floor\": 2,\n  \"features\": [\"Standing\"]\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Free desks on a date",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/desks/available?date={{date}}" }
        }
      ]
    },
    {
      "name": "3. Bookings",
      "item": [
        {
          "name": "Book a desk",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.collectionVariables.set('bookingId', pm.response.json().id);"] }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/bookings",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deskId\": \"{{deskId}}\",\n  \"date\": \"{{date}}\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "My bookings",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/bookings/mine" }
        },
        {
          "name": "All bookings on a date (manager)",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/bookings?date={{date}}" }
        },
        {
          "name": "Change booking",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/bookings/{{bookingId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deskId\": \"{{deskId}}\",\n  \"date\": \"{{date}}\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Cancel booking",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/bookings/{{bookingId}}" }
        }
      ]
    },
    {
      "name": "4. Clean up",
      "item": [
        {
          "name": "Delete desk",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/desks/{{deskId}}" }
        },
        {
          "name": "Sign out",
          "protocolProfileBehavior": { "followRedirects": false },
          "request": { "method": "POST", "url": "{{baseUrl}}/api/auth/logout" }
        }
      ]
    }
  ]
}
