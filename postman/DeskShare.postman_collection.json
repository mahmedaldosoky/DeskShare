{
  "info": {
    "name": "DeskShare API",
    "description": "End-to-end walkthrough of the DeskShare API.\n\n1. Start the API: `dotnet run --project src/DeskShare.Api --launch-profile http`\n2. Run the folders in order (or the whole collection with the Collection Runner).\n\nSign-in uses the Development login, so the API must run in the Development environment. Postman keeps the auth cookie in its cookie jar, so \"Sign in as ...\" switches the current user.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5266"
    },
    {
      "key": "deskCode",
      "value": ""
    },
    {
      "key": "secondDeskCode",
      "value": ""
    },
    {
      "key": "deskId",
      "value": ""
    },
    {
      "key": "secondDeskId",
      "value": ""
    },
    {
      "key": "bookingId",
      "value": ""
    },
    {
      "key": "bookingDate",
      "value": ""
    },
    {
      "key": "otherDate",
      "value": ""
    },
    {
      "key": "pastDate",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Lets single requests work even if \"0. Start\" was skipped.",
          "if (!pm.collectionVariables.get('bookingDate')) {",
          "  const pad = (n) => String(n).padStart(2, '0');",
          "  const toIso = (d) => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;",
          "  const bookingDate = new Date();",
          "  // A random future day keeps repeated runs from colliding with earlier data.",
          "  bookingDate.setDate(bookingDate.getDate() + 10 + Math.floor(Math.random() * 300));",
          "  const otherDate = new Date(bookingDate);",
          "  otherDate.setDate(otherDate.getDate() + 1);",
          "  const pastDate = new Date();",
          "  pastDate.setDate(pastDate.getDate() - 1);",
          "  pm.collectionVariables.set('bookingDate', toIso(bookingDate));",
          "  pm.collectionVariables.set('otherDate', toIso(otherDate));",
          "  pm.collectionVariables.set('pastDate', toIso(pastDate));",
          "  pm.collectionVariables.set('deskCode', 'PM-' + Math.floor(1000 + Math.random() * 9000));",
          "  pm.collectionVariables.set('secondDeskCode', 'PM-' + Math.floor(1000 + Math.random() * 9000) + 'B');",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "0. Start",
      "item": [
        {
          "name": "Sign out (start clean)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "logout"
              ]
            },
            "description": "Clears any old cookie and generates fresh test data (desk codes and dates)."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const pad = (n) => String(n).padStart(2, '0');",
                  "const toIso = (d) => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;",
                  "const bookingDate = new Date();",
                  "// A random future day keeps repeated runs from colliding with earlier data.",
                  "bookingDate.setDate(bookingDate.getDate() + 10 + Math.floor(Math.random() * 300));",
                  "const otherDate = new Date(bookingDate);",
                  "otherDate.setDate(otherDate.getDate() + 1);",
                  "const pastDate = new Date();",
                  "pastDate.setDate(pastDate.getDate() - 1);",
                  "pm.collectionVariables.set('bookingDate', toIso(bookingDate));",
                  "pm.collectionVariables.set('otherDate', toIso(otherDate));",
                  "pm.collectionVariables.set('pastDate', toIso(pastDate));",
                  "pm.collectionVariables.set('deskCode', 'PM-' + Math.floor(1000 + Math.random() * 9000));",
                  "pm.collectionVariables.set('secondDeskCode', 'PM-' + Math.floor(1000 + Math.random() * 9000) + 'B');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('302 redirects after sign-out', () => pm.response.to.have.status(302));"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "followRedirects": false
          }
        },
        {
          "name": "Session (anonymous)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/session",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "session"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('nobody is signed in', () => pm.expect(pm.response.json().user).to.be.null);"
                ]
              }
            }
          ]
        },
        {
          "name": "Anonymous request is rejected",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/bookings/mine",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "bookings",
                "mine"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    },
